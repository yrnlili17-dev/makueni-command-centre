@@ -0,0 +1,21 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createWardMatcher } from '../src/lib/ward-names.ts';
+
+const canonicalWard = createWardMatcher(['Kee', 'Kiima Kiu/Kalanzoni', 'Mtito Andei', 'Kako/Waia', 'Muvau/Kikumini', 'Emali/Mulala']);
+
+test('official ward names match regardless of case, spacing and "ward" suffix', () => {
+  assert.equal(canonicalWard('KEE WARD'), 'Kee');
+  assert.equal(canonicalWard(' kiima kiu / kalanzoni '), 'Kiima Kiu/Kalanzoni');
+  assert.equal(canonicalWard('Mtito-Andei'), 'Mtito Andei');
+});
+test('IEBC and common alternative spellings map to the official ward', () => {
+  assert.equal(canonicalWard('WAIA-KAKO'), 'Kako/Waia');
+  assert.equal(canonicalWard('MUVAU/KIKUUMINI'), 'Muvau/Kikumini');
+  assert.equal(canonicalWard('Emali'), 'Emali/Mulala');
+});
+test('blank or unknown wards are not guessed', () => {
+  assert.equal(canonicalWard(''), null);
+  assert.equal(canonicalWard(null), null);
+  assert.equal(canonicalWard('Nairobi West'), null);
+});
diff --git a/artifacts/commandcentre/src/components/dashboard-wards.tsx b/artifacts/commandcentre/src/components/dashboard-wards.tsx
