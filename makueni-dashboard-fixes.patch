+  const registered = wards.reduce((s, w) => s + w.registered, 0);
+  const predictedVotes = wards.reduce((s, w) => s + w.predictedVotes, 0);
+  const predictedCandidateVotes = wards.reduce((s, w) => s + w.predictedCandidateVotes, 0);
+  const topGotv = [...wards].sort((a, b) => b.gotvUpside - a.gotvUpside)[0];
+  return {
+    wards,
+    totals: {
+      registered, predictedVotes,
+      predictedTurnoutRate: registered ? Math.round((predictedVotes / registered) * 100) : 0,
+      predictedCandidateVotes,
+      predictedCandidateShare: predictedVotes ? Math.round((predictedCandidateVotes / predictedVotes) * 100) : 0,
+      topGotvWard: topGotv?.ward ?? null,
+      topGotvUpside: topGotv?.gotvUpside ?? 0,
+      wardsWithSavedAssumptions: wards.filter(w => w.hasSavedAssumption).length,
+      wardsInModel: wards.length,
+    },
+    defaults: { turnout: DEFAULT_TURNOUT, support: DEFAULT_SUPPORT },
+  };
+}
