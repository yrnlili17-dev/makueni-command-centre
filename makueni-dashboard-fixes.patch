@@ -0,0 +1,30 @@
+/** Letters only, lower case: "Kiima Kiu / Kalanzoni Ward" -> "kiimakiukalanzoni". */
+export function wardKey(value: string | null | undefined): string {
+  return String(value ?? "").toLowerCase().replace(/\bward\b/g, "").replace(/[^a-z]/g, "");
+}
+
+// Spellings seen in IEBC, KNBS and field lists for the official 30 wards.
+const ALIASES: Record<string, string> = {
+  waiakako: "Kako/Waia", kakowaia: "Kako/Waia", waia: "Kako/Waia", kako: "Kako/Waia",
+  muvaukikuumini: "Muvau/Kikumini", muvaukikumini: "Muvau/Kikumini", muvau: "Muvau/Kikumini", kikumini: "Muvau/Kikumini", kikuumini: "Muvau/Kikumini",
+  kithungo: "Kithungo/Kitundu", kitundu: "Kithungo/Kitundu", kithungokitundu: "Kithungo/Kitundu",
+  kiteta: "Kiteta/Kisau", kisau: "Kiteta/Kisau", kisaukiteta: "Kiteta/Kisau",
+  kiimakiu: "Kiima Kiu/Kalanzoni", kalanzoni: "Kiima Kiu/Kalanzoni", kiimakiukalanzoni: "Kiima Kiu/Kalanzoni",
+  nzaui: "Nzaui/Kilili/Kalamba", kilili: "Nzaui/Kilili/Kalamba", kalamba: "Nzaui/Kilili/Kalamba", nzauikililikalamba: "Nzaui/Kilili/Kalamba",
+  kitise: "Kitise/Kithuki", kithuki: "Kitise/Kithuki", kitisekithuki: "Kitise/Kithuki",
+  nguu: "Nguu/Masumba", masumba: "Nguu/Masumba", nguumasumba: "Nguu/Masumba",
+  emali: "Emali/Mulala", mulala: "Emali/Mulala", emalimulala: "Emali/Mulala",
+  ivingoni: "Ivingoni/Nzambani", nzambani: "Ivingoni/Nzambani", ivingoninzambani: "Ivingoni/Nzambani",
+  mtitoandei: "Mtito Andei", mtito: "Mtito Andei",
+  kikumbulyunorth: "Kikumbulyu North", kikumbulyusouth: "Kikumbulyu South",
+  wotetown: "Wote", kilungu: "Kilungu", kee: "Kee", ilima: "Ilima", ukia: "Ukia",
+};
+/** Returns a matcher giving the official ward name for free text, or null when blank or not recognisable. */
+export function createWardMatcher(officialWards: readonly string[]) {
+  const byKey = new Map<string, string>(officialWards.map(ward => [wardKey(ward), ward]));
+  for (const [k, v] of Object.entries(ALIASES)) if (!byKey.has(k) && officialWards.includes(v)) byKey.set(k, v);
+  return (value: string | null | undefined): string | null => {
+    const key = wardKey(value);
+    return key ? byKey.get(key) ?? null : null;
+  };
+}
