diff --git a/artifacts/api-server/src/lib/candidate-plan.ts b/artifacts/api-server/src/lib/candidate-plan.ts
new file mode 100644
index 0000000..8e3e8ce
--- /dev/null
+++ b/artifacts/api-server/src/lib/candidate-plan.ts
@@ -0,0 +1,127 @@
+import { db, volunteersTable, voterRegistryTable, pollingStationsTable, milestonesTable } from "@workspace/db";
+import { sql } from "drizzle-orm";
+import { MAKUENI_WARDS } from "../data/makueni-geography";
+import { computeTurnoutForecast } from "./turnout-forecast";
+import { canonicalWard } from "./ward-lookup";
+
+export type PlanMilestone = { title: string; description: string; dueDate: string; category: string; priority: "low" | "medium" | "high" | "critical"; owner: string; phase: string };
+
+const CANDIDATE = () => process.env.CANDIDATE_NAME?.trim() || "Prof. Philip Kaloki";
+const SEAT = "Governor, Makueni County";
+
+/** Live campaign facts the plan is built from (also given to the AI model). */
+export async function campaignPlanFacts() {
+  const [forecast, vols, contacts, stations, milestones] = await Promise.all([
+    computeTurnoutForecast(),
+    db.select({ ward: volunteersTable.ward, active: sql<number>`count(*) filter (where ${volunteersTable.status} = 'active')`, pending: sql<number>`count(*) filter (where ${volunteersTable.status} = 'pending')` }).from(volunteersTable).groupBy(volunteersTable.ward),
+    db.select({ ward: voterRegistryTable.ward, n: sql<number>`count(*)` }).from(voterRegistryTable).where(sql`${voterRegistryTable.status} <> 'rejected'`).groupBy(voterRegistryTable.ward),
+    db.select({ total: sql<number>`count(*)`, withAgent: sql<number>`count(nullif(trim(${pollingStationsTable.agentName}), ''))` }).from(pollingStationsTable),
+    db.select({ total: sql<number>`count(*)`, done: sql<number>`count(*) filter (where ${milestonesTable.status} = 'completed')` }).from(milestonesTable),
+  ]);
+  const volByWard = new Map<string, number>();
+  let pendingVolunteers = 0;
+  for (const v of vols) { const w = canonicalWard(v.ward); if (w) volByWard.set(w, (volByWard.get(w) ?? 0) + Number(v.active)); pendingVolunteers += Number(v.pending); }
+  const contactsByWard = new Map<string, number>();
+  for (const c of contacts) { const w = canonicalWard(c.ward); if (w) contactsByWard.set(w, (contactsByWard.get(w) ?? 0) + Number(c.n)); }
+  const wards = forecast.wards.map(w => ({ ...w, volunteers: volByWard.get(w.ward) ?? 0, contacts: contactsByWard.get(w.ward) ?? 0 }));
+  return {
+    candidate: CANDIDATE(), seat: SEAT,
+    registered: forecast.totals.registered, forecast: forecast.totals,
+    topGotvWards: [...wards].sort((a, b) => a.gotvRank - b.gotvRank).slice(0, 5).map(w => ({ ward: w.ward, upside: w.gotvUpside, registered: w.registered })),
+    wardsWithoutVolunteers: wards.filter(w => w.volunteers === 0).sort((a, b) => b.registered - a.registered).map(w => w.ward),
+    lowestReachWards: [...wards].filter(w => w.registered > 0).sort((a, b) => a.contacts / a.registered - b.contacts / b.registered).slice(0, 5).map(w => w.ward),
+    activeVolunteers: [...volByWard.values()].reduce((a, b) => a + b, 0), pendingVolunteers,
+    contacts: [...contactsByWard.values()].reduce((a, b) => a + b, 0),
+    stations: Number(stations[0]?.total ?? 0), stationsWithAgents: Number(stations[0]?.withAgent ?? 0),
+    milestones: Number(milestones[0]?.total ?? 0), milestonesDone: Number(milestones[0]?.done ?? 0),
+  };
+}
+export type PlanFacts = Awaited<ReturnType<typeof campaignPlanFacts>>;
+
+export function factsDigest(f: PlanFacts): string {
+  return [
+    `Candidate: ${f.candidate} · Seat: ${f.seat} (6 constituencies, 30 wards).`,
+    `Registered voters (IEBC 2022): ${f.registered.toLocaleString("en-KE")} across ${f.stations.toLocaleString("en-KE")} polling stations; ${f.stationsWithAgents} have an agent.`,
+    `Turnout model: ${f.forecast.predictedTurnoutRate}% turnout, ${f.forecast.predictedCandidateVotes.toLocaleString("en-KE")} forecast votes (${f.forecast.predictedCandidateShare}%). ${f.forecast.wardsWithSavedAssumptions}/${f.forecast.wardsInModel} wards have team estimates.`,
+    `Top GOTV wards: ${f.topGotvWards.map(w => `${w.ward} (${w.upside.toLocaleString("en-KE")})`).join(", ")}.`,
+    `Volunteers: ${f.activeVolunteers} active, ${f.pendingVolunteers} awaiting approval; ${f.wardsWithoutVolunteers.length} wards have none${f.wardsWithoutVolunteers.length ? ` (largest: ${f.wardsWithoutVolunteers.slice(0, 6).join(", ")})` : ""}.`,
+    `Constituent contacts in wards: ${f.contacts.toLocaleString("en-KE")}; lowest reach: ${f.lowestReachWards.join(", ")}.`,
+    `Existing plan milestones: ${f.milestones} (${f.milestonesDone} completed).`,
+  ].join("\n");
+}
+
+const iso = (d: Date) => d.toISOString().slice(0, 10);
+const addDays = (d: Date, n: number) => new Date(d.getTime() + n * 86_400_000);
+
+/**
+ * Candidate campaign plan from today to election day, phased backwards from the
+ * election date and shaped by live ward data. Statutory dates are placeholders to
+ * confirm against the IEBC and party timetables when they are published.
+ */
+export function buildCandidatePlan(f: PlanFacts, electionDate: string, todayIso = iso(new Date()), focus?: string): PlanMilestone[] {
+  const today = new Date(`${todayIso}T00:00:00Z`);
+  const election = new Date(`${electionDate}T00:00:00Z`);
+  const daysLeft = Math.max(1, Math.round((election.getTime() - today.getTime()) / 86_400_000));
+  // Place a milestone N days before the election, never in the past; spread early items from today.
+  // N days before the election; if that date has already passed, schedule it a week from today.
+  const before = (n: number) => { const d = addDays(election, -n); return iso(d < today ? addDays(today, Math.min(7, daysLeft - 1)) : d); };
+  const fromNow = (n: number) => iso(addDays(today, Math.min(n, daysLeft - 1)));
+  const gotv = f.topGotvWards.map(w => w.ward).join(", ");
+  const noVol = f.wardsWithoutVolunteers;
+  const agentGap = Math.max(0, f.stations - f.stationsWithAgents);
+  const C = f.candidate;
+  const plan: PlanMilestone[] = [
+    // Phase 1 · Foundation
+    { phase: "Foundation", title: "Confirm campaign leadership and budget", description: `Appoint campaign manager, finance lead, field director, communications lead and legal adviser for ${C}'s governor bid; approve a phased budget to ${electionDate}.`, dueDate: fromNow(14), category: "Logistics", priority: "critical", owner: "Candidate & campaign manager" },
+    { phase: "Foundation", title: "Appoint coordinators for all 30 wards", description: noVol.length ? `${noVol.length} wards have no active volunteer. Start with the largest: ${noVol.slice(0, 6).join(", ")}.` : "Every ward has an active volunteer; confirm one accountable coordinator per ward and 6 constituency leads.", dueDate: fromNow(30), category: "Ground Game", priority: "critical", owner: "Field director" },
+    { phase: "Foundation", title: "Approve pending volunteer registrations", description: f.pendingVolunteers ? `${f.pendingVolunteers} online registrations are awaiting approval in Volunteers. Call, verify ward and activate.` : "Review new online registrations weekly and activate within 48 hours.", dueDate: fromNow(7), category: "Ground Game", priority: "high", owner: "Volunteer coordinator" },
+    { phase: "Foundation", title: "Clean and assign the contact database", description: `${f.contacts.toLocaleString("en-KE")} contacts are matched to wards. Resolve contacts without a ward and lift reach in ${f.lowestReachWards.slice(0, 3).join(", ")}.`, dueDate: fromNow(21), category: "Polling", priority: "high", owner: "Data lead" },
+    { phase: "Foundation", title: "Baseline opinion poll across 6 constituencies", description: "Run a ward-weighted baseline on name recognition, top issues and voting intention; use results to set ward turnout and support estimates in Turnout.", dueDate: fromNow(45), category: "Polling", priority: "high", owner: "Research lead" },
+    { phase: "Foundation", title: "Finalise manifesto and message house", description: "Lock the five pillars (Nduani development, markets & prices, water, agriculture, health) with costed, verifiable commitments and one-line messages per constituency.", dueDate: fromNow(60), category: "Messaging", priority: "high", owner: "Policy & communications leads" },
+    // Phase 2 · Build
+    { phase: "Build", title: "Fundraising plan and compliance set-up", description: "Open the campaign account, set monthly targets, enable M-Pesa collections and record every contribution for IEBC campaign-finance reporting.", dueDate: fromNow(30), category: "Fundraising", priority: "high", owner: "Finance lead" },
+    { phase: "Build", title: "Voter registration and transfer drive", description: "Mobilise first-time voters and residents registered elsewhere during IEBC registration windows; track sign-ups per ward.", dueDate: before(300), category: "Ground Game", priority: "high", owner: "Youth & field coordinators" },
+    { phase: "Build", title: "Stakeholder and opinion-leader engagement", description: "Meet elders, faith leaders, chamas, boda boda and market associations in every constituency; log them in KOL Network with follow-ups.", dueDate: before(240), category: "Events", priority: "medium", owner: "Political liaison" },
+    { phase: "Build", title: "Manifesto launch and constituency tour", description: "Public launch, then a pillar-by-pillar tour of all 6 constituencies with local media.", dueDate: before(200), category: "Media", priority: "high", owner: "Communications lead" },
+    // Phase 3 · Nomination
+    { phase: "Nomination", title: "Secure the party ticket", description: "Complete party nomination requirements and primaries. Confirm exact dates against the party and IEBC timetables when gazetted.", dueDate: before(130), category: "Legal", priority: "critical", owner: "Legal adviser" },
+    { phase: "Nomination", title: "Select running mate and file IEBC nomination", description: "Agree the deputy governor running mate; prepare clearance documents and file nomination papers with the IEBC returning officer.", dueDate: before(90), category: "Legal", priority: "critical", owner: "Candidate & legal adviser" },
+    // Phase 4 · Persuade
+    { phase: "Persuade", title: "Door-to-door in the top GOTV wards", description: `Prioritise ${gotv}: these wards hold the most likely supporters not yet projected to vote. Log every visit in Field Ops.`, dueDate: before(75), category: "Ground Game", priority: "critical", owner: "Field director" },
+    { phase: "Persuade", title: "Monthly tracking polls", description: "Repeat the baseline monthly; update ward support estimates in Turnout after each wave.", dueDate: before(60), category: "Polling", priority: "high", owner: "Research lead" },
+    { phase: "Persuade", title: "Rapid response and narrative monitoring", description: "Daily social-listening scan, 2-hour response target for false claims, weekly media brief.", dueDate: before(60), category: "Narrative", priority: "high", owner: "Communications lead" },
+    { phase: "Persuade", title: "Candidate debates and major rallies", description: "Prepare debate briefs per pillar; one major rally per constituency in the final two months.", dueDate: before(30), category: "Events", priority: "high", owner: "Campaign manager" },
+    // Phase 5 · Protect & GOTV
+    { phase: "Protect the vote", title: "Recruit polling agents for every station", description: `${agentGap.toLocaleString("en-KE")} of ${f.stations.toLocaleString("en-KE")} polling stations still need an agent. Recruit one agent and one reserve per station.`, dueDate: before(35), category: "Logistics", priority: "critical", owner: "Election-day lead" },
+    { phase: "Protect the vote", title: "Train agents and test results transmission", description: "Train every agent on Form 37A/B/C checks; run a full test of tally entry in Election Day.", dueDate: before(14), category: "Logistics", priority: "critical", owner: "Election-day lead" },
+    { phase: "Get out the vote", title: "GOTV contact programme", description: `SMS/WhatsApp and phone reminders to opted-in supporters, starting with ${gotv}.`, dueDate: before(7), category: "GOTV", priority: "critical", owner: "Field director" },
+    { phase: "Get out the vote", title: "Election-day transport and logistics", description: "Transport for elderly and distant voters, agent meals and airtime, ward command posts.", dueDate: before(3), category: "GOTV", priority: "high", owner: "Logistics lead" },
+    { phase: "Get out the vote", title: "Election day: turnout and tally war room", description: "Hourly turnout check-ins per ward; verify and record Form 37A results from every station.", dueDate: electionDate, category: "GOTV", priority: "critical", owner: "Campaign manager" },
+  ];
+  if (focus?.trim()) plan.unshift({ phase: "Focus", title: `Focus: ${focus.trim().slice(0, 80)}`, description: `Set a measurable target, owner and weekly review for "${focus.trim().slice(0, 160)}".`, dueDate: fromNow(14), category: "Logistics", priority: "high", owner: "Campaign manager" });
+  return plan.sort((a, b) => a.dueDate.localeCompare(b.dueDate));
+}
+
+export function buildCandidateReadiness(f: PlanFacts) {
+  const items: Array<{ domain: string; item: string; weight: "low" | "medium" | "high"; notes?: string }> = [
+    { domain: "Legal & Compliance", item: "Party membership and nomination requirements confirmed in writing", weight: "high" },
+    { domain: "Legal & Compliance", item: "IEBC clearance documents ready (ID, degree certificate, tax compliance, EACC self-declaration)", weight: "high", notes: "Governor candidates must hold a degree recognised in Kenya." },
+    { domain: "Legal & Compliance", item: "Running mate agreed and cleared", weight: "high" },
+    { domain: "Financial", item: "Campaign bank account and M-Pesa collections set up", weight: "high" },
+    { domain: "Financial", item: "Budget approved by phase with monthly expenditure tracking", weight: "high" },
+    { domain: "Ground Game", item: "Coordinator appointed in all 30 wards", weight: "high", notes: f.wardsWithoutVolunteers.length ? `${f.wardsWithoutVolunteers.length} wards still have no active volunteer.` : "All wards covered." },
+    { domain: "Ground Game", item: "Polling agent and reserve for every station", weight: "high", notes: `${f.stationsWithAgents}/${f.stations} stations have an agent.` },
+    { domain: "Ground Game", item: "Door-to-door plan for top GOTV wards", weight: "high", notes: f.topGotvWards.map(w => w.ward).join(", ") },
+    { domain: "Messaging & Brand", item: "Manifesto with costed commitments for all five pillars", weight: "high" },
+    { domain: "Messaging & Brand", item: "Slogan, visual identity and Kikamba/Swahili/English materials", weight: "medium" },
+    { domain: "Media & PR", item: "Radio schedule on Kikamba-language and county stations, and press contacts list", weight: "medium" },
+    { domain: "Media & PR", item: "Crisis communication protocol and spokesperson", weight: "medium" },
+    { domain: "Polling & Intelligence", item: "Baseline poll completed and ward estimates entered in Turnout", weight: "high", notes: `${f.forecast.wardsWithSavedAssumptions}/${f.forecast.wardsInModel} wards have team estimates.` },
+    { domain: "Polling & Intelligence", item: "Opponent tracking and daily social listening", weight: "medium" },
+    { domain: "Technology & Data", item: "Contact database cleaned and assigned to wards", weight: "high", notes: `${f.contacts.toLocaleString("en-KE")} contacts in wards.` },
+    { domain: "Technology & Data", item: "SMS and WhatsApp providers active and tested", weight: "high" },
+    { domain: "Candidate Welfare", item: "Security plan, schedule management and transport", weight: "medium" },
+    { domain: "Candidate Welfare", item: "Rest days and health check-ups in the schedule", weight: "low" },
+  ];
+  return items;
+}
diff --git a/artifacts/api-server/src/lib/direct-message.ts b/artifacts/api-server/src/lib/direct-message.ts
new file mode 100644
index 0000000..3f4a8a0
--- /dev/null
+++ b/artifacts/api-server/src/lib/direct-message.ts
@@ -0,0 +1,90 @@
+import { db, pool, messagingProvidersTable, type MessagingProvider } from "@workspace/db";
+import { and, eq, inArray } from "drizzle-orm";
+import { missingProviderSettings, sendMetaWhatsApp, toWhatsAppDigits } from "./channel-senders";
+
+/**
+ * One-to-one operational text (e.g. "you have been assigned a task") through the
+ * active SMS provider, falling back to the active WhatsApp provider. Campaign
+ * broadcasts still go through Messaging, which enforces consent and segments.
+ */
+export type DirectResult = { ok: true; channel: string; provider: string; providerMessageId: string } | { ok: false; error: string; channel?: string; provider?: string };
+
+const SMS = ["africastalking", "onfonmedia", "twilio"];
+const WHATSAPP = ["meta", "twilio_wa"];
+
+async function sendWith(provider: MessagingProvider, phone: string, body: string): Promise<string> {
+  const digits = toWhatsAppDigits(phone);
+  switch (provider.provider) {
+    case "meta":
+      return sendMetaWhatsApp(provider, digits, body);
+    case "onfonmedia": {
+      if (!provider.apiKey || !provider.username || !provider.apiSecret || !provider.senderId) throw new Error("Onfon Media settings are incomplete");
+      const r = await fetch("https://api.onfonmedia.co.ke/v1/sms/SendBulkSMS", {
+        method: "POST", headers: { "Content-Type": "application/json", AccessKey: provider.apiSecret },
+        body: JSON.stringify({ SenderId: provider.senderId, IsUnicode: /[^\x00-\x7F]/.test(body), IsFlash: false, MessageParameters: [{ Number: digits, Text: body }], ApiKey: provider.apiKey, ClientId: provider.username }),
+        signal: AbortSignal.timeout(15_000),
+      });
+      const p = await r.json().catch(() => ({})) as { ErrorCode?: number | string; ErrorDescription?: string; Data?: Array<{ MessageId?: string }> };
+      const id = p.Data?.[0]?.MessageId;
+      if (!r.ok || !["0", "000"].includes(String(p.ErrorCode ?? "")) || !id) throw new Error(p.ErrorDescription ?? `Onfon Media HTTP ${r.status}`);
+      return id;
+    }
+    case "twilio":
+    case "twilio_wa": {
+      const sid = provider.username; const sender = String(provider.senderId || provider.phoneNumber || "").replace(/^whatsapp:/i, "").trim();
+      if (!sid || !provider.apiKey || !sender) throw new Error("Twilio settings are incomplete");
+      const wa = provider.provider === "twilio_wa";
+      const form = new URLSearchParams({ To: `${wa ? "whatsapp:" : ""}+${digits}`, From: wa ? `whatsapp:${sender}` : sender, Body: body });
+      const r = await fetch(`https://api.twilio.com/2010-04-01/Accounts/${sid}/Messages.json`, {
+        method: "POST", headers: { Authorization: `Basic ${Buffer.from(`${sid}:${provider.apiKey}`).toString("base64")}`, "Content-Type": "application/x-www-form-urlencoded" },
+        body: form, signal: AbortSignal.timeout(15_000),
+      });
+      const p = await r.json().catch(() => ({})) as { sid?: string; message?: string };
+      if (!r.ok || !p.sid) throw new Error(p.message ?? `Twilio HTTP ${r.status}`);
+      return p.sid;
+    }
+    default: {
+      if (!provider.apiKey || !provider.username) throw new Error("Africa's Talking settings are incomplete");
+      const form = new URLSearchParams({ username: provider.username, to: `+${digits}`, message: body });
+      if (provider.senderId) form.set("from", provider.senderId);
+      const r = await fetch("https://api.africastalking.com/version1/messaging", {
+        method: "POST", headers: { apiKey: provider.apiKey, Accept: "application/json", "Content-Type": "application/x-www-form-urlencoded" },
+        body: form, signal: AbortSignal.timeout(15_000),
+      });
+      const p = await r.json().catch(() => ({})) as { SMSMessageData?: { Recipients?: Array<{ messageId?: string; status?: string; statusCode?: number }> } };
+      const res = p.SMSMessageData?.Recipients?.[0];
+      if (!r.ok || !res?.messageId || (res.statusCode !== undefined && res.statusCode >= 400)) throw new Error(res?.status ?? `Africa's Talking HTTP ${r.status}`);
+      return res.messageId;
+    }
+  }
+}
+
+export async function sendDirectText(phone: string | null | undefined, body: string): Promise<DirectResult> {
+  if (!phone || !/^254[17]\d{8}$/.test(toWhatsAppDigits(phone))) return { ok: false, error: "No valid Kenyan phone number on record" };
+  const providers = await db.select().from(messagingProvidersTable)
+    .where(and(eq(messagingProvidersTable.isActive, true), inArray(messagingProvidersTable.provider, [...SMS, ...WHATSAPP])));
+  const ordered = [...providers.filter(p => SMS.includes(p.provider)), ...providers.filter(p => WHATSAPP.includes(p.provider))]
+    .filter(p => !missingProviderSettings(p));
+  if (!ordered.length) return { ok: false, error: "No active SMS or WhatsApp provider is configured in Messaging" };
+  let last: DirectResult = { ok: false, error: "Not sent" };
+  for (const provider of ordered) {
+    const channel = SMS.includes(provider.provider) ? "sms" : "whatsapp";
+    try {
+      return { ok: true, channel, provider: provider.provider, providerMessageId: await sendWith(provider, phone, body) };
+    } catch (err) {
+      last = { ok: false, channel, provider: provider.provider, error: String(err instanceof Error ? err.message : err).slice(0, 300) };
+    }
+  }
+  return last;
+}
+
+let ready: Promise<void> | undefined;
+/** Additive and repeatable: one row per notification attempt for a volunteer task. */
+export function ensureTaskNotificationTable(): Promise<void> {
+  if (!ready) ready = pool.query(`CREATE TABLE IF NOT EXISTS public.volunteer_task_notifications (
+    id serial PRIMARY KEY, task_id integer NOT NULL, volunteer_id integer NOT NULL, channel text, provider text,
+    provider_message_id text, status text NOT NULL, error text, created_at timestamptz NOT NULL DEFAULT now());
+    CREATE INDEX IF NOT EXISTS volunteer_task_notifications_task_idx ON public.volunteer_task_notifications(task_id, created_at DESC);`)
+    .then(() => undefined).catch(e => { ready = undefined; throw e; });
+  return ready;
+}
diff --git a/artifacts/api-server/src/lib/turnout-forecast.ts b/artifacts/api-server/src/lib/turnout-forecast.ts
new file mode 100644
index 0000000..09191f5
--- /dev/null
+++ b/artifacts/api-server/src/lib/turnout-forecast.ts
@@ -0,0 +1,76 @@
+import { db, pollingStationsTable, turnoutAssumptionsTable } from "@workspace/db";
+import { sql, inArray } from "drizzle-orm";
+import { MAKUENI_WARDS } from "../data/makueni-geography";
+
+const WARDS: string[] = MAKUENI_WARDS.map(({ ward }) => ward);
+
+// Baseline assumptions used for any ward that has no saved override.
+// These are configurable modelling defaults, not observed Makueni turnout; support is
+// intentionally neutral (50%) until the team sets ward-level estimates.
+export const DEFAULT_TURNOUT = 65;
+export const DEFAULT_SUPPORT = 50;
+
+const clamp = (n: number) => Math.max(0, Math.min(100, Math.round(n)));
+
+export type WardForecast = {
+  ward: string; constituency: string; stations: number; registered: number;
+  expectedTurnoutRate: number; supportShare: number; turnoutRate: number; effectiveSupportShare: number;
+  predictedVotes: number; predictedCandidateVotes: number; gotvUpside: number; gotvRank: number;
+  hasSavedAssumption: boolean;
+};
+
+/**
+ * Transparent model shared by Turnout, Dashboard and Analytics: real registered-voter
+ * counts per ward (IEBC 2022 polling stations) × adjustable turnout/support assumptions.
+ */
+export async function computeTurnoutForecast(turnoutDelta = 0, supportDelta = 0) {
+  const [wardRows, assumptions] = await Promise.all([
+    db.select({
+      ward: pollingStationsTable.ward,
+      registered: sql<number>`coalesce(sum(${pollingStationsTable.registeredVoters}), 0)`,
+      stations: sql<number>`count(*)`,
+    }).from(pollingStationsTable).where(inArray(pollingStationsTable.ward, WARDS)).groupBy(pollingStationsTable.ward),
+    db.select().from(turnoutAssumptionsTable),
+  ]);
+  const aMap = new Map(assumptions.map(a => [a.ward, a]));
+  const constituencyOf = new Map(MAKUENI_WARDS.map(w => [w.ward as string, w.constituency as string]));
+
+  const wards = wardRows.map(w => {
+    const registered = Number(w.registered);
+    const asmp = aMap.get(w.ward);
+    const baseTurnout = asmp?.expectedTurnoutRate ?? DEFAULT_TURNOUT;
+    const baseSupport = asmp?.muleSupportShare ?? DEFAULT_SUPPORT;
+    const turnoutRate = clamp(baseTurnout + turnoutDelta);
+    const supportShare = clamp(baseSupport + supportDelta);
+    const predictedVotes = Math.round((registered * turnoutRate) / 100);
+    const predictedCandidateVotes = Math.round((predictedVotes * supportShare) / 100);
+    // Mobilization upside: expected supporters who are NOT projected to vote.
+    const gotvUpside = Math.round(registered * (supportShare / 100) * (1 - turnoutRate / 100));
+    return {
+      ward: w.ward, constituency: constituencyOf.get(w.ward) ?? "", stations: Number(w.stations), registered,
