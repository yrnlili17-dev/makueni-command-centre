diff --git a/supabase/ward-backfill-20261024/00_preview_ward_backfill.sql b/supabase/ward-backfill-20261024/00_preview_ward_backfill.sql
new file mode 100644
index 0000000..81efe8f
--- /dev/null
+++ b/supabase/ward-backfill-20261024/00_preview_ward_backfill.sql
@@ -0,0 +1,140 @@
+-- PREVIEW ONLY · Makueni ward backfill · 2026-10-24
+-- Shows how many contacts would change, then ROLLS BACK. Nothing is saved.
+-- Run in the Makueni Supabase SQL Editor (the database used by Render's DATABASE_URL).
+-- Safe to re-run. Changes ONLY the ward/sub_county columns of public.voter_registry:
+--   A. Rewrites ward spellings that are not the official form ("KEE WARD", "Waia-Kako",
+--      "kiima kiu kalanzoni") to the official ward name.
+--   B. Fills a blank ward from the 21 Oct contact import when every ward listed for that
+--      contact in the import points to the same official ward, and it agrees with any
+--      constituency on the record.
+-- Every row it changes is copied first to public.makueni_ward_backfill_backup_20261024.
+-- Contacts with conflicting or unrecognised wards are left blank and listed at the end.
+BEGIN;
+SET LOCAL lock_timeout = '5s';
+SET LOCAL statement_timeout = '120s';
+
+CREATE OR REPLACE FUNCTION pg_temp.ward_key(raw text) RETURNS text LANGUAGE sql IMMUTABLE AS $$
+  SELECT regexp_replace(regexp_replace(lower(coalesce(raw, '')), '\mward\M', '', 'g'), '[^a-z]', '', 'g');
+$$;
+
+CREATE TEMP TABLE ward_map(key text PRIMARY KEY, ward text NOT NULL, constituency text NOT NULL) ON COMMIT DROP;
+INSERT INTO ward_map VALUES
+  ('emali','Emali/Mulala','Kibwezi West'),
+  ('emalimulala','Emali/Mulala','Kibwezi West'),
+  ('ilima','Ilima','Kaiti'),
+  ('ivingoni','Ivingoni/Nzambani','Kibwezi East'),
+  ('ivingoninzambani','Ivingoni/Nzambani','Kibwezi East'),
+  ('kako','Kako/Waia','Mbooni'),
+  ('kakowaia','Kako/Waia','Mbooni'),
+  ('kalamba','Nzaui/Kilili/Kalamba','Makueni'),
+  ('kalanzoni','Kiima Kiu/Kalanzoni','Kilome'),
+  ('kalawa','Kalawa','Mbooni'),
+  ('kasikeu','Kasikeu','Kilome'),
+  ('kathonzweni','Kathonzweni','Makueni'),
+  ('kee','Kee','Kaiti'),
+  ('kiimakiu','Kiima Kiu/Kalanzoni','Kilome'),
+  ('kiimakiukalanzoni','Kiima Kiu/Kalanzoni','Kilome'),
+  ('kikumbulyunorth','Kikumbulyu North','Kibwezi West'),
+  ('kikumbulyusouth','Kikumbulyu South','Kibwezi West'),
+  ('kikumini','Muvau/Kikumini','Makueni'),
+  ('kikuumini','Muvau/Kikumini','Makueni'),
+  ('kilili','Nzaui/Kilili/Kalamba','Makueni'),
+  ('kilungu','Kilungu','Kaiti'),
+  ('kisau','Kiteta/Kisau','Mbooni'),
+  ('kisaukiteta','Kiteta/Kisau','Mbooni'),
+  ('kiteta','Kiteta/Kisau','Mbooni'),
+  ('kitetakisau','Kiteta/Kisau','Mbooni'),
+  ('kithuki','Kitise/Kithuki','Makueni'),
+  ('kithungo','Kithungo/Kitundu','Mbooni'),
+  ('kithungokitundu','Kithungo/Kitundu','Mbooni'),
+  ('kitise','Kitise/Kithuki','Makueni'),
+  ('kitisekithuki','Kitise/Kithuki','Makueni'),
+  ('kitundu','Kithungo/Kitundu','Mbooni'),
+  ('makindu','Makindu','Kibwezi West'),
+  ('masongaleni','Masongaleni','Kibwezi East'),
+  ('masumba','Nguu/Masumba','Kibwezi West'),
+  ('mavindini','Mavindini','Makueni'),
+  ('mbitini','Mbitini','Makueni'),
+  ('mbooni','Mbooni','Mbooni'),
+  ('mtito','Mtito Andei','Kibwezi East'),
+  ('mtitoandei','Mtito Andei','Kibwezi East'),
+  ('mukaa','Mukaa','Kilome'),
+  ('mulala','Emali/Mulala','Kibwezi West'),
+  ('muvau','Muvau/Kikumini','Makueni'),
+  ('muvaukikumini','Muvau/Kikumini','Makueni'),
+  ('muvaukikuumini','Muvau/Kikumini','Makueni'),
+  ('nguu','Nguu/Masumba','Kibwezi West'),
+  ('nguumasumba','Nguu/Masumba','Kibwezi West'),
+  ('nguumo','Nguumo','Kibwezi West'),
+  ('nzambani','Ivingoni/Nzambani','Kibwezi East'),
+  ('nzaui','Nzaui/Kilili/Kalamba','Makueni'),
+  ('nzauikililikalamba','Nzaui/Kilili/Kalamba','Makueni'),
+  ('thange','Thange','Kibwezi East'),
+  ('tulimani','Tulimani','Mbooni'),
+  ('ukia','Ukia','Kaiti'),
+  ('waia','Kako/Waia','Mbooni'),
+  ('waiakako','Kako/Waia','Mbooni'),
+  ('wote','Wote','Makueni'),
+  ('wotetown','Wote','Makueni');
+
+CREATE TABLE IF NOT EXISTS public.makueni_ward_backfill_backup_20261024 AS
+SELECT id, ward, sub_county, now() AS backed_up_at FROM public.voter_registry WHERE false;
+CREATE UNIQUE INDEX IF NOT EXISTS makueni_ward_backfill_backup_20261024_id_idx ON public.makueni_ward_backfill_backup_20261024(id);
+ALTER TABLE public.makueni_ward_backfill_backup_20261024 ENABLE ROW LEVEL SECURITY;
+REVOKE ALL ON TABLE public.makueni_ward_backfill_backup_20261024 FROM PUBLIC, anon, authenticated;
+
+-- A. Plan: non-official spellings of a recognisable ward.
+CREATE TEMP TABLE ward_fix_spelling ON COMMIT DROP AS
+SELECT v.id, m.ward AS new_ward, m.constituency AS new_constituency
+FROM public.voter_registry v
+JOIN ward_map m ON m.key = pg_temp.ward_key(v.ward)
+WHERE nullif(btrim(v.ward), '') IS NOT NULL AND v.ward <> m.ward
+  AND (nullif(btrim(v.sub_county), '') IS NULL OR btrim(v.sub_county) = m.constituency
+       OR (btrim(v.sub_county) = 'Kibwezi' AND m.constituency IN ('Kibwezi East', 'Kibwezi West')));
+
+-- B. Plan: blank wards with one unambiguous ward in the contact import.
+CREATE TEMP TABLE ward_fill_blank(id integer PRIMARY KEY, new_ward text, new_constituency text) ON COMMIT DROP;
+DO $$ BEGIN
+  IF to_regclass('public.makueni_contacts_stage_20261021') IS NOT NULL THEN
+    INSERT INTO ward_fill_blank
+    SELECT v.id, min(m.ward), min(m.constituency)
+    FROM public.voter_registry v
+    JOIN public.makueni_contacts_stage_20261021 s ON s.registry_id = v.id
+    CROSS JOIN LATERAL regexp_split_to_table(concat_ws(';', s.ward, s.source_wards), '\s*[;|,]\s*') AS raw(w)
+    JOIN ward_map m ON m.key = pg_temp.ward_key(raw.w)
+    WHERE nullif(btrim(v.ward), '') IS NULL
+    GROUP BY v.id, v.sub_county
+    HAVING count(DISTINCT m.ward) = 1
+       AND (nullif(btrim(v.sub_county), '') IS NULL OR btrim(min(v.sub_county)) = min(m.constituency)
+            OR (btrim(min(v.sub_county)) = 'Kibwezi' AND min(m.constituency) IN ('Kibwezi East', 'Kibwezi West')));
+  END IF;
+END $$;
+
+INSERT INTO public.makueni_ward_backfill_backup_20261024
+SELECT v.id, v.ward, v.sub_county, now() FROM public.voter_registry v
+WHERE v.id IN (SELECT id FROM ward_fix_spelling UNION SELECT id FROM ward_fill_blank)
+ON CONFLICT (id) DO NOTHING;
+
+UPDATE public.voter_registry v SET ward = f.new_ward,
+  sub_county = CASE WHEN nullif(btrim(v.sub_county), '') IS NULL OR btrim(v.sub_county) = 'Kibwezi' THEN f.new_constituency ELSE v.sub_county END,
+  updated_at = now()
+FROM ward_fix_spelling f WHERE f.id = v.id;
+
+UPDATE public.voter_registry v SET ward = f.new_ward,
+  sub_county = CASE WHEN nullif(btrim(v.sub_county), '') IS NULL OR btrim(v.sub_county) = 'Kibwezi' THEN f.new_constituency ELSE v.sub_county END,
+  review_notes = concat_ws(E'\n', nullif(v.review_notes, ''), 'Ward filled 2026-10-24 from contact import source wards (single unambiguous official ward).'),
+  updated_at = now()
+FROM ward_fill_blank f WHERE f.id = v.id;
+
+SELECT 'spelling corrected' AS change, count(*) AS records FROM ward_fix_spelling
+UNION ALL SELECT 'blank ward filled from import', count(*) FROM ward_fill_blank;
+-- Ward totals as they would be after the backfill (still inside the transaction).
+-- Where contacts now sit (rejected records excluded), plus what is still unresolved.
+SELECT coalesce(m.ward, CASE WHEN nullif(btrim(v.ward), '') IS NULL THEN '(no ward)' ELSE '(not an official ward: ' || v.ward || ')' END) AS ward,
+       count(*) AS contacts
+FROM public.voter_registry v
+LEFT JOIN (VALUES ('Tulimani'), ('Mbooni'), ('Kithungo/Kitundu'), ('Kiteta/Kisau'), ('Kako/Waia'), ('Kalawa'), ('Kiima Kiu/Kalanzoni'), ('Mukaa'), ('Kasikeu'), ('Kee'), ('Kilungu'), ('Ilima'), ('Ukia'), ('Nzaui/Kilili/Kalamba'), ('Muvau/Kikumini'), ('Kathonzweni'), ('Mavindini'), ('Kitise/Kithuki'), ('Wote'), ('Mbitini'), ('Makindu'), ('Kikumbulyu North'), ('Kikumbulyu South'), ('Nguumo'), ('Nguu/Masumba'), ('Emali/Mulala'), ('Masongaleni'), ('Mtito Andei'), ('Thange'), ('Ivingoni/Nzambani')) AS m(ward) ON m.ward = v.ward
+WHERE v.status <> 'rejected'
+GROUP BY 1 ORDER BY 2 DESC;
+
+ROLLBACK;
