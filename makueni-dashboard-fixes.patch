+import { useQuery } from "@tanstack/react-query";
+import { Link } from "wouter";
+
+type Projection = {
+  candidate: string;
+  history2022: { candidates: { name: string; votes: number }[]; candidateVoteSum: number; winner: { name: string; votes: number }; sources: { title: string; date: string; locator: string; url: string }[]; note: string };
+  projection2027: { registered: number; predictedTurnoutRate: number; predictedVotes: number; predictedCandidateVotes: number; predictedCandidateShare: number; majorityThreshold: number; gapToMajority: number; vs2022Winner: number; wardsWithSavedAssumptions: number; wardsInModel: number;
+    byConstituency: { constituency: string; registered: number; predictedVotes: number; predictedCandidateVotes: number; gotvUpside: number; share: number }[] };
+  method: string;
+};
+const n = (v: number) => v.toLocaleString("en-KE");
+
+/** Governor results (2022) and the 2027 projection, side by side. */
+export function GovernorRace() {
