@@ -0,0 +1,171 @@
+import { useQuery } from "@tanstack/react-query";
+import { Link } from "wouter";
+import { useMemo, useState } from "react";
+import { TrendingUp } from "lucide-react";
+
+type WardRow = {
+  ward: string; constituency: string; registered: number; contacts: number; contactsWithPhone: number;
+  members: number; activeVolunteers: number; pendingVolunteers: number; doorsKnocked: number;
+  contactReachPct: number | null; expectedTurnoutRate: number | null; predictedVotes: number | null;
+  predictedCandidateVotes: number | null; gotvUpside: number | null; gotvRank: number | null;
+};
+type WardsResponse = {
+  wards: WardRow[];
+  totals: { contacts: number; contactsInWards: number; unassignedContacts: number; unmatchedContacts: number; members: number; activeVolunteers: number; pendingVolunteers: number; doorsKnocked: number; wardsWithContacts: number };
+  forecast: { registered: number; predictedVotes: number; predictedTurnoutRate: number; predictedCandidateVotes: number; predictedCandidateShare: number; topGotvWard: string | null; topGotvUpside: number; wardsWithSavedAssumptions: number; wardsInModel: number };
+  updatedAt: string;
+};
+
+const fmt = (n: number | null | undefined) => (n == null ? "—" : n.toLocaleString("en-KE"));
+
+export function useDashboardWards() {
+  return useQuery<WardsResponse>({
+    queryKey: ["dashboard-wards"], refetchInterval: 30_000, staleTime: 0,
+    queryFn: async () => {
+      const r = await fetch(`${import.meta.env.BASE_URL}api/dashboard/wards`, { credentials: "include" });
+      if (!r.ok) throw new Error("Ward data unavailable");
+      return r.json();
+    },
+  });
+}
+
+export function TurnoutForecastCard() {
+  const { data, isError, refetch } = useDashboardWards();
+  if (isError) return <div role="alert" className="rounded-lg border border-red-400/30 bg-red-400/5 p-4 text-sm">Turnout forecast is unavailable. <button onClick={() => void refetch()} className="underline">Retry</button></div>;
+  const f = data?.forecast;
+  const cards: Array<[string, string, string]> = f ? [
+    ["REGISTERED VOTERS", fmt(f.registered), `IEBC 2022 · ${f.wardsInModel} wards`],
+    ["FORECAST TURNOUT", `${f.predictedTurnoutRate}%`, `${fmt(f.predictedVotes)} expected votes`],
+    ["FORECAST CANDIDATE VOTES", fmt(f.predictedCandidateVotes), `${f.predictedCandidateShare}% of votes cast`],
+    ["TOP GOTV WARD", f.topGotvWard ?? "—", f.topGotvWard ? `${fmt(f.topGotvUpside)} supporters not yet projected to vote` : ""],
+  ] : [];
+  return (
+    <section className="bg-card border border-border">
+      <div className="px-4 py-3 border-b border-border flex flex-wrap items-center justify-between gap-2">
+        <span className="flex items-center gap-2 font-mono text-xs tracking-widest"><TrendingUp className="w-4 h-4 text-primary" />Voter turnout forecast · Governor 2027</span>
+        <Link href="/turnout" className="text-xs text-primary underline">Adjust ward assumptions →</Link>
+      </div>
+      <div className="p-4 space-y-3">
+        <div className="grid grid-cols-2 lg:grid-cols-4 gap-3">
+          {f ? cards.map(([label, value, sub]) => (
+            <div key={label} className="bg-secondary/50 px-3 py-3">
+              <p className="font-mono text-[9px] text-muted-foreground">{label}</p>
+              <p className="font-bold text-xl tabular-nums text-primary">{value}</p>
+              <p className="font-mono text-[9px] text-muted-foreground mt-1">{sub}</p>
+            </div>
+          )) : Array.from({ length: 4 }).map((_, i) => <div key={i} className="h-20 bg-secondary/50 animate-pulse" />)}
+        </div>
+        {f && <p className="text-xs text-muted-foreground">
+          Scenario model, not a poll: registered voters × each ward’s expected turnout × expected support.
+          {f.wardsWithSavedAssumptions < f.wardsInModel ? ` ${f.wardsInModel - f.wardsWithSavedAssumptions} of ${f.wardsInModel} wards still use the default 65% turnout and 50% support — set real estimates in Turnout.` : " All wards use saved estimates."}
+        </p>}
+      </div>
+    </section>
+  );
+}
+
+export function WardBreakdown() {
+  const { data, isError, refetch } = useDashboardWards();
+  const [constituency, setConstituency] = useState("all");
+  const rows = useMemo(() => (data?.wards ?? []).filter(w => constituency === "all" || w.constituency === constituency), [data, constituency]);
+  const constituencies = useMemo(() => [...new Set((data?.wards ?? []).map(w => w.constituency))], [data]);
+  if (isError) return <div role="alert" className="rounded-lg border border-red-400/30 bg-red-400/5 p-4 text-sm">Ward data is unavailable. <button onClick={() => void refetch()} className="underline">Retry</button></div>;
+  const t = data?.totals;
+  return (
+    <section className="bg-card border border-border min-w-0">
+      <div className="px-4 py-3 border-b border-border flex flex-wrap items-center justify-between gap-2">
+        <span className="font-mono text-xs tracking-widest">Ward coverage · all modules</span>
+        <select aria-label="Filter by constituency" value={constituency} onChange={e => setConstituency(e.target.value)} className="bg-secondary border border-border px-2 py-1 font-mono text-[10px]">
+          <option value="all">All constituencies</option>
+          {constituencies.map(c => <option key={c} value={c}>{c}</option>)}
+        </select>
+      </div>
+      {t && <p className="px-4 pt-3 text-xs text-muted-foreground">
+        {fmt(t.contacts)} constituent contacts: {fmt(t.contactsInWards)} matched to {t.wardsWithContacts} of 30 wards
+        {t.unassignedContacts ? `, ${fmt(t.unassignedContacts)} with no ward recorded` : ""}
+        {t.unmatchedContacts ? `, ${fmt(t.unmatchedContacts)} with a ward name that is not one of the 30 official wards` : ""}.
+        {(t.unassignedContacts + t.unmatchedContacts) > 0 && <> <Link href="/voters-db" className="text-primary underline">Review in Constituent Database</Link></>}
+      </p>}
+      <div className="overflow-x-auto p-4">
+        <table className="w-full text-xs tabular-nums">
+          <thead className="text-muted-foreground font-mono text-[9px] tracking-widest">
+            <tr className="text-left">
+              <th className="p-2">WARD</th><th className="p-2">CONSTITUENCY</th><th className="p-2 text-right">REGISTERED</th>
+              <th className="p-2 text-right">CONTACTS</th><th className="p-2 text-right">REACH</th><th className="p-2 text-right">MEMBERS</th>
+              <th className="p-2 text-right">VOLUNTEERS</th><th className="p-2 text-right">DOORS</th>
+              <th className="p-2 text-right">TURNOUT</th><th className="p-2 text-right">FORECAST VOTES</th><th className="p-2 text-right">GOTV RANK</th>
+            </tr>
+          </thead>
+          <tbody>
+            {data ? rows.map(w => (
+              <tr key={w.ward} className="border-t border-border">
+                <td className="p-2 font-medium">{w.ward}</td>
+                <td className="p-2 text-muted-foreground">{w.constituency}</td>
+                <td className="p-2 text-right">{fmt(w.registered)}</td>
+                <td className="p-2 text-right">{fmt(w.contacts)}</td>
+                <td className="p-2 text-right">{w.contactReachPct == null ? "—" : `${w.contactReachPct}%`}</td>
+                <td className="p-2 text-right">{fmt(w.members)}</td>
+                <td className="p-2 text-right">{w.activeVolunteers}{w.pendingVolunteers ? <span className="text-amber-400"> +{w.pendingVolunteers}</span> : null}</td>
+                <td className="p-2 text-right">{fmt(w.doorsKnocked)}</td>
+                <td className="p-2 text-right">{w.expectedTurnoutRate == null ? "—" : `${w.expectedTurnoutRate}%`}</td>
+                <td className="p-2 text-right">{fmt(w.predictedCandidateVotes)}</td>
+                <td className="p-2 text-right">{w.gotvRank ?? "—"}</td>
+              </tr>
+            )) : <tr><td colSpan={11} className="p-6 text-center text-muted-foreground">Loading wards…</td></tr>}
+          </tbody>
+        </table>
+      </div>
+      <p className="px-4 pb-4 text-[10px] text-muted-foreground">Contacts come from the Constituent Database; members, volunteers (amber = awaiting approval) and door knocks from their modules. Reach = contacts ÷ registered voters. Forecast votes = expected votes for the candidate in that ward.</p>
+    </section>
+  );
+}
+
+type RecordRow = { key: string; label: string; href: string; available: boolean; total: number; last7Days: number; lastAt: string | null; extra: number | null };
+const EXTRA_LABEL: Record<string, (n: number) => string> = {
+  volunteers: n => `${n.toLocaleString("en-KE")} awaiting approval`,
+  volunteerTasks: n => `${n.toLocaleString("en-KE")} completed`,
+  messageCampaigns: n => `${n.toLocaleString("en-KE")} recipients`,
+  donations: n => `KES ${n.toLocaleString("en-KE")} received`,
+  narrativeMentions: n => `${n.toLocaleString("en-KE")} still open`,
+  milestones: n => `${n.toLocaleString("en-KE")} completed`,
+};
+function ago(iso: string | null) {
+  if (!iso) return "nothing yet";
+  const mins = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
+  if (mins < 1) return "just now";
+  if (mins < 60) return `${mins} min ago`;
+  if (mins < 1440) return `${Math.round(mins / 60)} h ago`;
+  return new Date(iso).toLocaleDateString("en-KE", { day: "numeric", month: "short", year: "numeric" });
+}
+
+/** Every module's captured records, so nothing entered in the system is missing from the dashboard. */
+export function RecordsCaptured() {
+  const { data, isError, refetch } = useQuery<{ records: RecordRow[]; updatedAt: string }>({
+    queryKey: ["dashboard-records"], refetchInterval: 30_000, staleTime: 0,
+    queryFn: async () => {
+      const r = await fetch(`${import.meta.env.BASE_URL}api/dashboard/records`, { credentials: "include" });
+      if (!r.ok) throw new Error("Records unavailable");
+      return r.json();
+    },
+  });
+  if (isError) return <div role="alert" className="rounded-lg border border-red-400/30 bg-red-400/5 p-4 text-sm">Captured records are unavailable. <button onClick={() => void refetch()} className="underline">Retry</button></div>;
+  return (
+    <section className="bg-card border border-border">
+      <div className="px-4 py-3 border-b border-border flex flex-wrap items-center justify-between gap-2">
+        <span className="font-mono text-xs tracking-widest">Records captured · all modules</span>
+        {data && <span className="font-mono text-[9px] text-muted-foreground">Updated {new Date(data.updatedAt).toLocaleTimeString("en-KE")}</span>}
+      </div>
+      <div className="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-2 p-4">
+        {data ? data.records.map(r => (
+          <Link key={r.key} href={r.href} className="block bg-secondary/50 hover:bg-secondary px-3 py-3 min-w-0">
+            <p className="font-mono text-[9px] text-muted-foreground truncate">{r.label.toUpperCase()}</p>
+            <p className="font-bold text-xl tabular-nums">{r.available ? r.total.toLocaleString("en-KE") : "—"}</p>
+            <p className="font-mono text-[9px] text-primary">{r.available ? `+${r.last7Days.toLocaleString("en-KE")} this week` : "not set up yet"}</p>
+            {r.extra !== null && EXTRA_LABEL[r.key] && <p className="font-mono text-[9px] text-muted-foreground truncate">{EXTRA_LABEL[r.key]!(r.extra)}</p>}
+            <p className="font-mono text-[9px] text-muted-foreground">Last: {ago(r.lastAt)}</p>
+          </Link>
+        )) : Array.from({ length: 12 }).map((_, i) => <div key={i} className="h-24 bg-secondary/50 animate-pulse" />)}
+      </div>
+    </section>
+  );
+}
