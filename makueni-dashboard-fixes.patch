+      return r.json();
+    },
+  });
+  if (error) return <section role="alert" className="rounded-2xl border border-border p-5">Governor results and projection could not be loaded. <button className="underline" onClick={() => void refetch()}>Retry</button></section>;
+  if (!data) return <section className="rounded-2xl border border-border p-5">Loading governor race…</section>;
+  const p = data.projection2027;
+  const h = data.history2022;
+  const winning = p.gapToMajority <= 0;
+  return (
+    <section className="space-y-4 rounded-2xl border border-emerald-400/20 bg-emerald-950/10 p-4 sm:p-6">
+      <div className="flex flex-wrap items-start justify-between gap-2">
+        <div><h2 className="text-lg font-semibold">Governor race · Makueni County</h2><p className="text-sm text-muted-foreground">2022 results and the 2027 projection for {data.candidate}</p></div>
+        <Link href="/turnout" className="text-xs text-primary underline">Change ward assumptions →</Link>
+      </div>
+
+      <div className="grid grid-cols-2 lg:grid-cols-4 gap-3">
+        {[
+          ["2027 FORECAST VOTES", n(p.predictedCandidateVotes), `${p.predictedCandidateShare}% of ${n(p.predictedVotes)} expected votes`],
+          ["MAJORITY OF VOTES CAST", n(p.majorityThreshold), winning ? `Ahead by ${n(-p.gapToMajority + 1)}` : `${n(p.gapToMajority)} more votes needed`],
+          ["VS 2022 WINNING TOTAL", `${p.vs2022Winner >= 0 ? "+" : ""}${n(p.vs2022Winner)}`, `${h.winner.name}: ${n(h.winner.votes)} in 2022`],
+          ["FORECAST TURNOUT", `${p.predictedTurnoutRate}%`, `${n(p.registered)} registered (IEBC 2022)`],
+        ].map(([label, value, sub]) => (
+          <div key={label} className="bg-secondary/50 px-3 py-3">
+            <p className="font-mono text-[9px] text-muted-foreground">{label}</p>
+            <p className={`font-bold text-xl tabular-nums ${label === "MAJORITY OF VOTES CAST" ? (winning ? "text-green-400" : "text-amber-400") : "text-primary"}`}>{value}</p>
+            <p className="font-mono text-[9px] text-muted-foreground mt-1">{sub}</p>
+          </div>
+        ))}
+      </div>
+      {p.wardsWithSavedAssumptions < p.wardsInModel && <p className="text-xs text-amber-400">{p.wardsInModel - p.wardsWithSavedAssumptions} of {p.wardsInModel} wards still use the default 65% turnout / 50% support. Enter poll-based estimates in Turnout for a meaningful projection.</p>}
+
+      <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
+        <div className="overflow-x-auto">
+          <table className="w-full text-sm tabular-nums"><caption className="text-left pb-2 text-xs text-muted-foreground">2027 projection by constituency</caption>
+            <thead><tr className="text-left text-xs text-muted-foreground"><th className="p-2">Constituency</th><th className="p-2 text-right">Registered</th><th className="p-2 text-right">Forecast votes</th><th className="p-2 text-right">Share</th><th className="p-2 text-right">GOTV upside</th></tr></thead>
+            <tbody>{p.byConstituency.map(c => <tr key={c.constituency} className="border-t border-border"><td className="p-2">{c.constituency}</td><td className="p-2 text-right">{n(c.registered)}</td><td className="p-2 text-right">{n(c.predictedCandidateVotes)}</td><td className="p-2 text-right">{c.share}%</td><td className="p-2 text-right">{n(c.gotvUpside)}</td></tr>)}</tbody>
+          </table>
+        </div>
+        <div className="overflow-x-auto">
+          <table className="w-full text-sm tabular-nums"><caption className="text-left pb-2 text-xs text-muted-foreground">2022 governor results (reported totals)</caption>
+            <thead><tr className="text-left text-xs text-muted-foreground"><th className="p-2">Candidate</th><th className="p-2 text-right">Votes</th><th className="p-2 text-right">Share</th></tr></thead>
+            <tbody>{h.candidates.map(c => <tr key={c.name} className="border-t border-border"><td className="p-2">{c.name}</td><td className="p-2 text-right">{n(c.votes)}</td><td className="p-2 text-right">{Math.round(c.votes / h.candidateVoteSum * 100)}%</td></tr>)}</tbody>
+          </table>
+        </div>
+      </div>
+      <p className="text-xs text-muted-foreground">{data.method}</p>
+      <details className="text-xs"><summary className="cursor-pointer">Sources for the 2022 results</summary>
+        <p className="mt-2 text-muted-foreground">{h.note}</p>
+        <ul className="mt-2 space-y-1">{h.sources.map(s => <li key={s.url}><a className="text-primary underline" target="_blank" rel="noreferrer" href={s.url}>{s.title}</a> · {s.date} · {s.locator}</li>)}</ul>
+      </details>
+    </section>
+  );
+}
